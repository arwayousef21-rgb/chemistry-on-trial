{
  "name": "chemistry-on-trial",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "مهمة الاتزان – THE EQUILIBRIUM MISSION — bilingual adaptive chemical-equilibrium learning platform (Stage 2: visual foundation)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b && tsc -p worker",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:seed:local": "wrangler d1 execute DB --local --file=seed/synthetic.sql",
    "db:reset:local": "rm -rf .wrangler/state && npm run db:migrate:local && npm run db:seed:local",
    "dev:full": "npm run build && npm run db:migrate:local && npm run db:seed:local && wrangler dev --local --port 8787",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:update": "npm run build && playwright test --update-snapshots"
  },
  "dependencies": {
    "@fontsource/cairo": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "katex": "0.16.22",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261113.1",
    "@playwright/test": "1.63.0",
    "@types/katex": "0.16.7",
    "@types/node": "22.10.2",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3",
    "vite": "5.4.20",
    "vitest": "2.1.9",
    "wrangler": "4.162.0"
  }
}
